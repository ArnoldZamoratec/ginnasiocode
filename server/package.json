{
  "name": "@gymos/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/db/cli-migrate.ts",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
